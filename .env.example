# Copy to .env.local and enter your own authorized key privately.
# Only OPENAI_API_KEY is read from this file. Never commit a real key.
# Audio processing remains local. A key enables paid proposals, not free usage.
OPENAI_API_KEY=

# Set PORT and SONILOOM_DISABLE_AI in the process environment, NOT here.
# macOS/Linux offline example: SONILOOM_DISABLE_AI=1 PORT=8796 npm start
# Model configuration currently lives in server/ai.mjs; there is no model env setting.
